<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sub_item"
    android:padding="@dimen/margin_3">

    <LinearLayout
        android:id="@+id/rootTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iconTitle"
            android:layout_width="24dp"
            android:layout_height="24dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/textTopStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/rootTitle"
        android:layout_marginTop="@dimen/margin"
        android:background="@color/subitem_border" />

    <LinearLayout
        android:id="@+id/rootTimeStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line"
        android:layout_marginTop="@dimen/margin"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iconCenterStart"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/icon_clock" />

        <Space
            android:layout_width="4dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/textCenterStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rootTimeEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/line"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/margin"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iconCenterEnd"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/icon_clock" />

        <Space
            android:layout_width="4dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/textCenterEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textBottomStart"
        android:layout_width="match_parent"
        android:layout_toStartOf="@+id/textBottomEnd"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rootTimeStart"
        android:layout_marginTop="@dimen/margin"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/textBottomEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rootTimeStart"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/margin"
        android:textColor="@color/white" />
</RelativeLayout>