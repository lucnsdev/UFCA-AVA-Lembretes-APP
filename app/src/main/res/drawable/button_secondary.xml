<?xml version="1.0" encoding="UTF-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

<!-- DISABLED STATE -->
<item android:state_enabled="false">
    <shape android:shape="rectangle">
        <stroke android:width="@dimen/border" android:color="@color/item_border" />
        <corners android:radius="@dimen/radius_major"/>
        <solid android:color="@color/item_background" />
    </shape>
</item>

<!-- NORMAL STATE -->
<item>
    <ripple android:color="@color/white">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="@color/white" />
                <corners android:radius="@dimen/margin_4" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <stroke android:width="@dimen/border" android:color="@color/button_secondary_border" />
                <corners android:radius="@dimen/radius_major"/>
                <solid android:color="@color/button_secondary_background" />
            </shape>
        </item>
    </ripple>
</item>
</selector>
